# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Or use Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection
LLM_PROVIDER=openai  # options: openai, anthropic
LLM_MODEL=gpt-4-turbo-preview  # or claude-3-sonnet-20240229

# Embedding Configuration
EMBEDDING_PROVIDER=openai  # options: openai, sentence-transformers
EMBEDDING_MODEL=text-embedding-3-small  # or all-MiniLM-L6-v2 for local

# Vector Store
CHROMA_PERSIST_DIRECTORY=./data/vectorstore

# Upload Settings
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./data/uploads

# Server
HOST=0.0.0.0
PORT=8000

# AWS Configuration (for Athena)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
ATHENA_OUTPUT_LOCATION=s3://your-athena-output-bucket/
ATHENA_WORKGROUP=primary

# AWS SSL Configuration
# Set to false if you're behind a corporate proxy with SSL inspection
# IMPORTANT: Only disable in development/corporate environments with trusted networks
AWS_VERIFY_SSL=false
